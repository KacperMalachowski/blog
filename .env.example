# Notion Integration Token — notion.so/my-integrations
NOTION_TOKEN=secret_xxxx

# ID of the Notion database used as the blog CMS
# Required properties: Title (title), Slug (text), Status (select: Published|Draft),
#   Published (date), Tags (multi_select), Summary (text), Lang (select: pl|en)
NOTION_BLOG_DATABASE_ID=xxxx
