---
import Layout from './Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import type { Post } from '../lib/notion';

interface Props {
  post: Post;
  content: string;
}

const { post, content } = Astro.props;

const formattedDate = post.publishedAt
  ? new Date(post.publishedAt).toLocaleDateString('pl-PL', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : '';

const readingTime = Math.ceil(content.split(/\s+/).length / 200);
---

<Layout title={`${post.title} | Kacper Małachowski`} description={post.summary}>
  <Header />
  <main class="max-w-3xl mx-auto px-4 py-12 w-full flex-1">
    <article>
      <header class="mb-10">
        {post.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-4">
            {post.tags.map(tag => (
              <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-zinc-100 dark:bg-zinc-800 text-zinc-600 dark:text-zinc-400">
                {tag}
              </span>
            ))}
          </div>
        )}
        <h1 class="text-3xl sm:text-4xl font-semibold leading-tight mb-4">{post.title}</h1>
        {post.summary && (
          <p class="text-lg text-zinc-500 dark:text-zinc-400 mb-6">{post.summary}</p>
        )}
        <div class="flex items-center gap-3 text-sm text-zinc-400 dark:text-zinc-500">
          {formattedDate && <time datetime={post.publishedAt}>{formattedDate}</time>}
          <span>·</span>
          <span>{readingTime} min czytania</span>
        </div>
      </header>
      <div
        class="prose dark:prose-invert prose-zinc max-w-none prose-code:font-mono prose-pre:bg-zinc-100 dark:prose-pre:bg-zinc-800"
        set:html={content}
      />
    </article>
    <nav class="mt-16 pt-8 border-t border-zinc-200 dark:border-zinc-800">
      <a
        href="/blog"
        class="text-sm text-zinc-500 hover:text-zinc-800 dark:hover:text-zinc-200 transition-colors"
      >
        ← Wróć do bloga
      </a>
    </nav>
  </main>
  <Footer />
</Layout>
